# ytcc-dl 部署配置模板 —— 复制为 .env 后填入真实值（.env 已被 .gitignore 排除，不会入库）

# CookieCloud 服务器（必填）：你的 CookieCloud 服务端地址
COOKIECLOUD_HOST=http://192.168.1.100:10888
# CookieCloud 凭据（必填）：UUID 与密码，与浏览器扩展里设置的一致
CC_UUID=your-cookiecloud-uuid
CC_PASSWORD=your-cookiecloud-password

# 海外站点（YouTube / X / TikTok）访问代理：填 http://host:port 或 socks5://host:port
# 国内站点（B站/抖音/微博/小红书）在代码里强制直连，不使用此代理
PROXY_OVERSEAS=http://192.168.1.100:10808

# 下载产物输出目录（容器内固定 /app/output；宿主持久化目录按需改）
OUT_DIR=/app/output
HOST_DOWNLOAD_DIR=/your/nas/share/Downloads/ytcc
